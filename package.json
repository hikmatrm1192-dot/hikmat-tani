    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:d1:migrate": "tsx server/db/d1/migrate.ts",
    "test": "tsx tests/final-smoke-test.test.ts && tsx tests/cost-calculation.test.ts && tsx tests/backend.test.ts && tsx tests/d1-schema.test.ts && tsx tests/sync.test.ts && tsx tests/replication.test.ts && tsx tests/outboxConsumer.test.ts && tsx tests/knowledge.test.ts && tsx tests/weather.test.ts && tsx tests/admin.test.ts && tsx tests/e2e-integration.test.ts && tsx tests/production-startup.test.ts",
    "test:smoke": "tsx tests/final-smoke-test.test.ts",
    "test:cost": "tsx tests/cost-calculation.test.ts",
    "test:backend": "tsx tests/backend.test.ts",
    "test:d1": "tsx tests/d1-schema.test.ts",
    "test:sync": "tsx tests/sync.test.ts",
    "test:replication": "tsx tests/replication.test.ts",
    "test:outbox": "tsx tests/outboxConsumer.test.ts",
    "test:knowledge": "tsx tests/knowledge.test.ts",
    "test:weather": "tsx tests/weather.test.ts",
    "test:admin": "tsx tests/admin.test.ts",
    "test:e2e": "tsx tests/e2e-integration.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
