# HIKMAT TANI - Environment Configuration Guide
# Slogan Resmi: "Bijak Bertani, Cerdas Bertani"

# Server & Runtime Configuration
PORT=3000
NODE_ENV=development

# Security & JWT Authentication (Wajib diganti dengan string acak panjang di production)
# Contoh generate secret: openssl rand -base64 32
JWT_SECRET=your-secure-jwt-secret-key-change-in-production
CORS_ORIGIN=*

# PostgreSQL Database (Drizzle ORM / Cloud SQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/hikmat_tani

# Optional: Tautan Donasi Eksternal Sukarela (Saweria / Kitabisa / QRIS / dsb)
VITE_DONATION_URL=

